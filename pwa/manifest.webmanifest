{
  "id": "./",
  "name": "PhotoCraft — Community PWA",
  "short_name": "PhotoCraft",
  "description": "Installable image editor based on the open-source PhotoCraft WebAssembly application.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#151925",
  "theme_color": "#151925",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
